menu "Example Configuration"

    config ESP_WIFI_SSID
        string "WiFi SSID"
        default "My Network SSID"
        help
            SSID (network name) for the example to connect to.
    config ESP_WIFI_PASSWORD
        string "WiFi Password"
        default "My Password"
        help
            WiFi password (WPA or WPA2) for the example to use.
    config OPENAI_API_KEY
        string "OpenAI Key"
        default "sk-xxxxxxxx"
        help
            OpenAI api key for the example to use.
    config OPENAI_URL
        string "Base URL"
        default "https://api.openai.com/v1/"
        help
            Base URL for OpenAI API
    config ASSISTANT_REPLY_SCROLL_CPS
        int "Answer scrolling speed (characters per second)"
        default 16
        range 5 60
        help
            The answer scrolls on screen following the speech, read at this many characters per second.
            Overridden by the "Scroll_speed" key of CONFIG.INI.

    config ASSISTANT_LANGUAGE
        string "Default assistant language"
        default "fr"
        help
            ISO-639-1 code (fr, en, ...) written to the "Language" key when it does not exist yet.
    config ASSISTANT_CHAT_MODEL
        string "Default chat model"
        default "claude-haiku-5-5"
        help
            Model (claude-... or gpt-...) written to the "Chat_model" key when it does not exist yet.
    config ANTHROPIC_API_KEY
        string "Anthropic (Claude) key"
        default ""
        help
            Anthropic API key written to the "Claude_key" key when it does not exist yet.

endmenu