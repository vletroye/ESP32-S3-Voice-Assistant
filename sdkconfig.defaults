# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_SR_WN_WN9L_FR_BONJOURESP_TTS3=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=8192
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_FREERTOS_HZ=1000
# Measured peak ~0.4 KB: frees internal RAM
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2048
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# TLS buffers in PSRAM: internal RAM is too tight with the AFE running
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_CUSTOM=y
# LVGL objects in PSRAM: see main/lvgl_psram/lv_psram.h
CONFIG_LV_MEM_CUSTOM_INCLUDE="lv_psram.h"
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED=80
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"

# BSP
CONFIG_BSP_BOARD_ESP32_S3_BOX_3=y
CONFIG_BSP_LCD_DRAW_BUF_HEIGHT=10


# Assistant
CONFIG_ASSISTANT_REPLY_SCROLL_CPS=16
CONFIG_ASSISTANT_LANGUAGE="en"
CONFIG_ASSISTANT_CHAT_MODEL="claude-haiku-5-5"
CONFIG_ASSISTANT_STT_MODEL="gpt-live-transcribe"
CONFIG_ASSISTANT_END_OF_SPEECH_MS=900
CONFIG_ASSISTANT_TTS_MODEL="gpt-realtime-2.1-mini"
CONFIG_ASSISTANT_TTS_VOICE="marin"
CONFIG_ASSISTANT_TIMEZONE="CET-1CEST,M3.5.0,M10.5.0/3"
CONFIG_ASSISTANT_FOLLOWUP_WINDOW_MS=4000

# Main task: app_main reads files and JSON at start-up (3584 by default overflowed)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# HTTP Upgrade answer of a WebSocket: ElevenLabs (Cloudflare) sends more than 1 KB of headers
CONFIG_WS_BUFFER_SIZE=4096
